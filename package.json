{
  "name": "proof-of-progress",
  "version": "0.1.0",
  "private": true,
  "description": "Municipal engineering office tool: claimed progress checked against milestone photos, one entry flowing to four report drafts.",
  "main": "src/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "STORE=memory PHOTOS=local node src/server.js",
    "seed": "SEED=reset node src/seed/seed.js",
    "secret-scan": "bash scripts/secret-scan.sh .",
    "test": "bash scripts/test-all.sh",
    "test:unit": "node --test test/unit/*.test.js",
    "test:api": "node --test test/api/*.test.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/storage": "^7.22.0",
    "@google/genai": "^2.30.0",
    "exifr": "^7.1.3",
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0"
  }
}
